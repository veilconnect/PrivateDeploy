diff --git a/internal/frontend/desktop/linux/browser.go b/internal/frontend/desktop/linux/browser.go
--- a/internal/frontend/desktop/linux/browser.go
+++ b/internal/frontend/desktop/linux/browser.go
@@ -6,5 +6,7 @@ package linux
 import (
 	"fmt"
-	"github.com/pkg/browser"
+	"os"
+	"os/exec"
+	"strings"
 	"github.com/wailsapp/wails/v2/internal/frontend/utils"
 )
@@ -18,6 +20,63 @@ func (f *Frontend) BrowserOpenURL(rawURL string) {
 	}
 	// Specific method implementation
-	if err := browser.OpenURL(url); err != nil {
+	if err := openBrowserWithCleanEnvironment(url); err != nil {
 		f.logger.Error("Unable to open default system browser")
 	}
 }
+
+var externalProcessBlockedEnvironment = map[string]struct{}{
+	"APPDIR":                           {},
+	"APPIMAGE":                         {},
+	"LD_LIBRARY_PATH":                  {},
+	"LD_PRELOAD":                       {},
+	"GIO_MODULE_DIR":                   {},
+	"GIO_USE_VFS":                      {},
+	"GTK_DATA_PREFIX":                  {},
+	"GTK_THEME":                        {},
+	"GDK_BACKEND":                      {},
+	"XDG_DATA_DIRS":                    {},
+	"GSETTINGS_SCHEMA_DIR":             {},
+	"GI_TYPELIB_PATH":                  {},
+	"GTK_EXE_PREFIX":                   {},
+	"GTK_PATH":                         {},
+	"GTK_IM_MODULE_FILE":               {},
+	"GDK_PIXBUF_MODULE_FILE":           {},
+	"GDK_PIXBUF_MODULEDIR":             {},
+	"WEBKIT_EXEC_PATH":                 {},
+	"WEBKIT_INJECTED_BUNDLE_PATH":      {},
+	"JSC_SIGNAL_FOR_GC":                {},
+	"JSC_useJIT":                       {},
+	"LIBGL_ALWAYS_SOFTWARE":            {},
+	"WEBKIT_DISABLE_COMPOSITING_MODE":  {},
+	"WEBKIT_DISABLE_DMABUF_RENDERER":   {},
+	"WEBKIT_SKIA_ENABLE_CPU_RENDERING": {},
+	"__EGL_VENDOR_LIBRARY_FILENAMES":   {},
+	"__GLX_VENDOR_LIBRARY_NAME":        {},
+	"MESA_LOADER_DRIVER_OVERRIDE":      {},
+	"GALLIUM_DRIVER":                   {},
+}
+
+func cleanExternalProcessEnvironment() []string {
+	environment := make([]string, 0, len(os.Environ()))
+	for _, entry := range os.Environ() {
+		key, _, _ := strings.Cut(entry, "=")
+		if _, blocked := externalProcessBlockedEnvironment[key]; blocked {
+			continue
+		}
+		environment = append(environment, entry)
+	}
+	return environment
+}
+
+func openBrowserWithCleanEnvironment(url string) error {
+	providers := []string{"xdg-open", "x-www-browser", "www-browser"}
+	for _, provider := range providers {
+		if _, err := exec.LookPath(provider); err != nil {
+			continue
+		}
+		command := exec.Command(provider, url)
+		command.Env = cleanExternalProcessEnvironment()
+		return command.Run()
+	}
+	return &exec.Error{Name: strings.Join(providers, ","), Err: exec.ErrNotFound}
+}
